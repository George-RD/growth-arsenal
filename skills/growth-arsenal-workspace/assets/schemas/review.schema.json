{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/George-RD/growth-arsenal/schemas/review.schema.json",
  "title": "Growth Arsenal independent review",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviewer", "issues"],
  "properties": {
    "reviewer": {"type": "string", "minLength": 1},
    "score": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
    "top_concern": {"type": "string"},
    "submitted_at": {"type": "string"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_key", "finding"],
        "properties": {
          "issue_key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string"},
          "severity": {"enum": ["suggestion", "warning", "critical"]},
          "finding": {"type": "string"},
          "evidence": {"type": "string"},
          "recommended_fix": {"type": "string"},
          "blocking": {"type": "boolean"}
        }
      }
    }
  }
}
